# LOCAL mode (default): no variables needed. Reachable only at http://127.0.0.1:8788.
#
# PUBLIC mode: set PUBLIC_ORIGIN and ADMIN_TOKEN. On a host, set them in the dashboard's
# environment variables. Never commit a .env file.

# Public URL without a trailing slash. Turns on public mode.
PUBLIC_ORIGIN=https://your-demo.example.app

# Required in public mode, at least 16 characters. Example: openssl rand -hex 24
ADMIN_TOKEN=

# Required when hosted, so the server is reachable from outside the container
HOST=0.0.0.0
# Usually set automatically by the platform
PORT=8788

# Set to 1 behind a reverse proxy (almost every PaaS). Without it, all visitors
# count as one IP and the rate limits (5 logins per 10 minutes) are shared.
TRUST_PROXY=1

# Receipt signing key, one line (produced by: node make-receipt-key.js).
# Required if the host's disk is wiped on restart. If empty, a new key is created
# and every older receipt stops being valid.
RECEIPT_KEY_PEM=

# Optional: folder for invoices.json and receipt-key.pem (point it at a persistent disk)
# DATA_DIR=/data

# Optional: testnet lightwalletd and explorer
# LIGHTWALLETD=https://testnet.zec.rocks:443
# EXPLORER=https://testnet.zcashexplorer.app/transactions/

# Optional: a pre-filled merchant session for the demo. Use a throwaway testnet key.
# DEMO_UFVK=uviewtest1...
# DEMO_BIRTHDAY=
# DEMO_ADDRESS=utest1...

# Mainnet (real ZEC): selective proof tool, invoices, /pay and receipts. On by default locally, off on a public host.
# LIGHTWALLETD_MAINNET=https://zec.rocks:443
# EXPLORER_MAINNET=https://mainnet.zcashexplorer.app/transactions/
# Only on a server that only you run: a viewing key will travel to it.
# ALLOW_PUBLIC_MAINNET=1

# Number of mined confirmations required before an observed payment becomes PAID.
# Until this threshold is reached the invoice is CONFIRMING and no receipt can be issued.
MIN_CONFIRMATIONS=3
